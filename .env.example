# Required: YNAB Personal Access Token (YNAB → Account Settings → Developer Settings → New Token)
YNAB_ACCESS_TOKEN=
# Required for HTTP mode: secret protecting the MCP endpoint. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Optional: default plan (budget) id. Defaults to "last-used".
YNAB_PLAN_ID=
# Optional: how long cached data is considered fresh before a delta sync (seconds). Default 300.
CACHE_TTL_SECONDS=300
# Optional: enable write tools (create/update/delete transactions, assign money). Default off.
YNAB_ALLOW_WRITES=false
